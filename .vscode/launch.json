{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex Debug",
            "type": "cortex-debug",
            "request": "attach",
            "cwd": "${workspaceFolder}",

            "servertype": "openocd",
            "runToEntryPoint": "entry",
            "executable": "./build/badhal",
            
            "device": "STM32H750X",
            "svdFile": "${workspaceFolder}/STM32H750.svd",
            "configFiles": ["board/stm32h750b-disco.cfg"],

            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4,
            },


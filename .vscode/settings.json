    "cmake.configureOnOpen": false,
    "cortex-debug.variableUseNaturalFormat": false,
    "files.associations": {
        ".clang-format": "yaml"
    },
    "[c]": {
        "editor.defaultFormatter": "xaver.clang-format"
    },
    "[cpp]": {
        "editor.defaultFormatter": "xaver.clang-format"
    },
    "C_Cpp.errorSquiggles": "disabled",
    "vscode-serial-monitor.customBaudRates": [460800, 921600]
}
